# Copy this file to .env and fill in your own values.
# Never commit or share .env — it contains your database password and JWT secret.

# MongoDB Atlas connection string (database name: portfolio_blog)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/portfolio_blog?retryWrites=true&w=majority

# 64 random hex characters. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters

# Local API port
PORT=3000

# Allowed browser origin(s) for CORS. Comma-separated list for production.
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when the API runs behind a reverse proxy such as Render.
TRUST_PROXY=0

# Optional rate-limit overrides (defaults match Lab 19: 10 auth / 5 contact per 15 min)
# AUTH_RATE_LIMIT_MAX=10
# CONTACT_RATE_LIMIT_MAX=5
